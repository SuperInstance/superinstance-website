{
  "version": "1.0",
  "kind": "quilt-zip-target",
  "name": "cocapn-family-to-quilt",
  "description": "Bridge mapping 77 cocapn-* repos to Quilt cells. The cocapn family is the federation layer of the cell model.",
  "cells": [
    {
      "id": "cocapn_cocapn",
      "kind": "cell",
      "form": {
        "name": "Cocapn"
      },
      "description": "repo-first Agent for local or cloud, grow an agent in a repo",
      "language": "python",
      "primitives": [
        "Spawn",
        "Spawn",
        "Resize",
        "Move",
        "Observe"
      ],
      "z_in": {
        "input": "fleet signal"
      },
      "z_out": {
        "output": "cell action"
      },
      "jepa": {
        "predict": "next fleet state",
        "observe": "actual state"
      },
      "double_entry": {
        "gamma": 0.5,
        "eta": 0.5
      },
      "vibe": {
        "position": 0,
        "velocity": 1,
        "acceleration": 0
      },
      "gc": {
        "phase": "active"
      },
      "murmur": {
        "gossip_to": [],
        "gossip_from": []
      },
      "graph": {
        "parents": [],
        "children": []
      },
      "openers": [
        {
          "name": "step",
          "args": [],
          "returns": "State"
        },
        {
          "name": "federate",
          "args": [
            "Cell"
          ],
          "returns": "Unit"
        }
      ],
      "substrate": {
        "address": "/cocapn/cocapn",
        "scale": 1,
        "room": "CocapnRoom",
        "protocol": "A2A",
        "form": "cocapn",
        "state": "active"
      },
      "tags": [
        "cocapn",
        "fleet",
        "python",
        "quilt-cell"
      ]
    },
