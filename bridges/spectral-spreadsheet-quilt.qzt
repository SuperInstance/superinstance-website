  "graph_families": [
    {
      "name": "Path Graphs",
      "description": "Simple paths with n vertices",
      "spectral_properties": {
        "eigenvalues": "2*cos(k*pi/(n+1)) for k=1,...,n",
        "spectral_gap": "2 - 2*cos(pi/(n+1))",
        "cr": "~2/(n+1) for large n"
      },
      "examples": [
        "P3",
        "P4",
        "P5"
      ]
    },
    {
      "name": "Cycle Graphs",
      "description": "Cycles with n vertices",
      "spectral_properties": {
        "eigenvalues": "2*cos(2*pi*k/n) for k=0,...,n-1",
        "spectral_gap": "2 - 2*cos(2*pi/n)",
        "cr": "2/n"
      },
      "examples": [
        "C3",
        "C4",
        "C5"
      ]
    },
    {
      "name": "Complete Graphs",
      "description": "Fully connected graphs with n vertices",
      "spectral_properties": {
        "eigenvalues": "n-1 (once), -1 (n-1 times)",
        "spectral_gap": "n",
        "cr": "~1/n"
      },
      "examples": [
        "K3",
        "K4",
        "K5"
      ]
    },
    {
      "name": "Star Graphs",
      "description": "Central vertex connected to all others",
      "spectral_properties": {
        "eigenvalues": "sqrt(n-1), -sqrt(n-1), 0 (n-2 times)",
        "spectral_gap": "1",
        "cr": "1/sqrt(n-1)"
      },
      "examples": [
        "S3",
        "S4",
        "S5"
      ]
    }
  ],
  "features": {
    "cell_kinds": [
