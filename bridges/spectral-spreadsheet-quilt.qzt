  "formulas": [
    {
      "name": "=EIGVAL",
      "description": "Compute the largest eigenvalue of a graph's adjacency matrix",
      "implementation": "lambda_max(A) where A is the adjacency matrix",
      "parameters": [
        "matrix_ref"
      ],
      "category": "spectral"
    },
    {
      "name": "=CR",
      "description": "Compute the Cheeger Ratio (isoperimetric number)",
      "implementation": "min(|\u2202S|/|S|) for all subsets S of vertices",
      "parameters": [
        "graph_ref"
      ],
      "category": "spectral"
    },
    {
      "name": "=FIEDLER",
      "description": "Compute the Fiedler vector (second smallest eigenvector of Laplacian)",
      "implementation": "eigenvector corresponding to second smallest eigenvalue of L",
      "parameters": [
        "graph_ref"
      ],
      "category": "spectral"
    },
    {
      "name": "=SPECTRAL_GAP",
      "description": "Compute the spectral gap (difference between largest eigenvalues)",
      "implementation": "lambda_1 - lambda_2",
      "parameters": [
        "matrix_ref"
      ],
      "category": "spectral"
    },
    {
      "name": "=ADJ_MATRIX",
      "description": "Get the adjacency matrix of a graph",
      "implementation": "A[i][j] = 1 if vertices i and j are adjacent, else 0",
      "parameters": [
        "graph_ref"
      ],
      "category": "spectral"
    },
    {
      "name": "=DEGREE",
      "description": "Compute the degree matrix of a graph",
      "implementation": "D[i][i] = degree of vertex i",
      "parameters": [
        "graph_ref"
      ],
      "category": "spectral"
    }
  ],
