{
  "schema": "quilt-zip-target/v1",
  "metadata": {
    "name": "Sonar-Vision as Quilt sheet",
    "description": "The sonar-vision project (pure-Python active sonar simulation, signal processing, multi-object tracking, spatial mapping) ported to Quilt. The 5-stage pipeline is a cell chain. The components are cells. The cannonball is a vertical column of depth cells. The cameras are draggable assets. The ML training uses the camera daisy chain as supervised data. The STT input is human supervision. The confidence tiers progress from trigger-everything to trigger-only-unusual. This is what the Quilt IDE for sonar-vision looks like.",
    "generated": "2026-08-21T01:45:38Z",
    "address_root": "sonarvision"
  },
