      "source": "ReceiptSorter",
      "target": "CountingEngine",
      "type": "informs",
      "description": "ReceiptSorter informs CountingEngine of new inventory"
    },
    {
      "source": "HighlightReel",
      "target": "WesleyCore",
      "type": "reports",
      "description": "HighlightReel reports notable events to WesleyCore"
    }
