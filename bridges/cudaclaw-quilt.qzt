{
  "schema_version": "0.1",
  "sheet_name": "CudaClaw GPU Persistent Worker Kernel",
  "sheet_version": "1.0",
  "created": "2026-08-21T03:26:08.510013+00:00",
  "metadata": {
    "performance": {
      "host_device_communication": "sub-microsecond",
      "queue_operation": "lock-free",
      "parallelism": "warp-level",
      "memory_type": "unified",
      "agents_per_warp": 32,
      "dispatch_operations": 8
    }
  },
  "substrate": {
    "type": "unified_memory",
    "description": "Unified memory space shared between host and device",
    "properties": {
      "memory_type": "CUDA_DEVICE_MANAGED",
      "access": "host_device_shared",
      "coherence": "hardware_managed",
      "allocation": "cudaMallocManaged"
    }
  },
  "cells": [
    {
      "id": "prim_command_queue",
      "type": "primitive",
      "name": "CommandQueue",
      "description": "Lock-free command queue in unified memory for agent command dispatch",
      "metadata": {
        "implementation": "lock_free",
        "memory": "unified",
        "operations": [
          "enqueue",
          "dequeue",
          "peek"
        ],
        "synchronization": "atomic_operations",
        "performance": "O(1) operations"
      },
      "connections": [
        {
          "target": "prim_cuda_kernel",
          "type": "polled_by"
        },
        {
          "target": "substrate_unified_memory",
          "type": "memory_backing"
        }
      ],
      "timestamp": "2026-08-21T03:26:08.508867+00:00"
    },
    {
      "id": "prim_cuda_kernel",
      "type": "primitive",
      "name": "CudaKernel",
      "description": "Persistent worker kernel that polls the command queue",
      "metadata": {
        "type": "persistent_kernel",
        "polling": "continuous",
        "execution": "gpu_resident",
        "lifetime": "application_duration"
      },
      "connections": [
        {
          "target": "prim_command_queue",
          "type": "polls"
        },
        {
          "target": "prim_agent",
          "type": "manages"
        },
        {
          "target": "substrate_unified_memory",
          "type": "memory_backing"
        }
      ],
      "timestamp": "2026-08-21T03:26:08.508910+00:00"
    },
    {
      "id": "prim_agent",
      "type": "primitive",
      "name": "Agent",
      "description": "Agent entity with 32 instances per warp for parallel command processing",
      "metadata": {
        "instances_per_warp": 32,
        "parallelism": "warp_level",
        "state": "per_agent",
        "scheduling": "warp_cooperative"
      },
      "connections": [
        {
          "target": "prim_dispatch_op",
          "type": "executes"
        },
        {
          "target": "substrate_unified_memory",
          "type": "memory_backing"
        }
      ],
      "timestamp": "2026-08-21T03:26:08.508915+00:00"
    },
    {
      "id": "prim_dispatch_op",
      "type": "primitive",
      "name": "DispatchOp",
      "description": "Operation to be dispatched to agents for execution",
      "metadata": {
        "types": [
          "compute",
          "memory",
          "sync",
          "io"
        ],
        "priority_levels": 4,
        "queueing": "fifo",
        "execution_model": "async"
      },
      "connections": [
        {
          "target": "substrate_unified_memory",
          "type": "memory_backing"
        }
      ],
      "timestamp": "2026-08-21T03:26:08.508919+00:00"
    },
    {
      "id": "prim_memory_page",
      "type": "primitive",
      "name": "MemoryPage",
      "description": "Unified memory page for data exchange between host and device",
      "metadata": {
        "page_size": "4096_bytes",
        "memory_type": "unified",
        "access_pattern": "random",
        "coherence": "hardware_managed"
      },
      "connections": [
        {
          "target": "prim_command_queue",
          "type": "backing_memory"
        },
        {
          "target": "substrate_unified_memory",
          "type": "memory_backing"
        }
      ],
      "timestamp": "2026-08-21T03:26:08.508922+00:00"
    },
