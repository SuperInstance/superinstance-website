{
  "schema": "quilt-zip-target/v1",
  "metadata": {
    "name": "Spline-spectral as Quilt sheet",
    "description": "The spline-spectral insight: B-spline basis functions are eigenvectors of the path graph Laplacian. The Cox-de Boor recurrence is Fibonacci for function spaces. Spline smoothing and spectral filtering solve the same variational problem. The function space is a graph; the basis functions are the eigenvectors; the recurrence is Fibonacci; the smoothing is filtering.",
    "generated": "2026-08-21T01:31:46Z",
    "address_root": "splinespectral"
  },
  "rooms": [
    {
      "id": "graph",
      "name": "\ud83d\udd78 Path graph (Laplacian, eigenvalues)",
      "cell_count": 61
    },
    {
      "id": "spline",
      "name": "\u3030\ufe0f B-spline (degree 3, 5 control points)",
      "cell_count": 17
    },
    {
      "id": "eval",
      "name": "\ud83d\udcd0 Cox-de Boor evaluations (9 samples \u00d7 5 i \u00d7 4 p)",
      "cell_count": 180
    },
    {
      "id": "graphspline",
      "name": "\ud83c\udfaf GraphSpline smoothing (constrained min f^T L f)",
      "cell_count": 7
    },
    {
      "id": "theorem",
      "name": "\ud83d\udcdc The theorem (3 claims + objective)",
      "cell_count": 4
    },
    {
      "id": "repo",
      "name": "\ud83d\udcda Supporting repos (4 spectral/graph)",
      "cell_count": 20
    }
  ],
