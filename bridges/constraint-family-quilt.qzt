{
  "version": "1.0",
  "kind": "quilt-zip-target",
  "name": "constraint-family-to-quilt",
  "description": "Bridge mapping 47 constraint-* repos to Quilt cells. The constraint family is the constraint algebra of the cell model.",
  "cells": [
    {
      "id": "constraint_constraint_audio",
      "kind": "cell",
      "form": {
        "name": "ConstraintAudio"
      },
      "description": "Rust audio DSP backend for the constraint-theory ecosystem",
      "language": "rust",
      "primitives": [
        "Spawn",
        "Observe",
        "Mutate",
        "Observe",
        "Send",
        "Receive"
      ],
      "z_in": {
        "input": "constraint spec"
      },
      "z_out": {
        "output": "satisfied?"
      },
      "jepa": {
        "predict": "constraint holds",
        "observe": "actual"
      },
      "double_entry": {
        "gamma": 0.6,
        "eta": 0.4
      },
      "vibe": {
        "position": 0,
        "velocity": 0,
        "acceleration": 0
      },
      "gc": {
        "phase": "constraining"
      },
      "murmur": {},
      "graph": {
        "parents": [],
        "children": []
      },
      "openers": [
        {
          "name": "satisfy",
          "args": [
            "Spec"
          ],
          "returns": "Bool"
        },
        {
          "name": "propagate",
          "args": [
            "State"
          ],
          "returns": "State"
        }
      ],
      "substrate": {
        "address": "/constraint/constraint-audio",
        "scale": 0,
        "room": "ConstraintRoom",
        "protocol": "Constraint",
        "form": "constraint-audio",
        "state": "ready"
      },
      "tags": [
        "constraint",
        "math",
        "rust",
